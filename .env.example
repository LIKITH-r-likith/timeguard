# Copy to .env and fill in. Never commit .env
# Groq API Key (default provider):
GROQ_API_KEY=

# Or any OpenAI-compatible provider (OpenAI, Together, Ollama, vLLM, etc.):
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Model name:
LLM_MODEL=llama-3.3-70b-versatile

# LLM execution mode:
# demo = scripted deterministic 5-story demo model (no key needed)
# live = call live LLM provider
# replay = use recorded cache (evals/replay/*.json)
# mock = scripted fake for unit tests
LLM_MODE=demo
